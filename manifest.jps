type: install
id: haxcms
name: HAX
baseUrl: https://raw.githubusercontent.com/reclaimhosting/haxcms-jps/master
logo: images/HAXLogo.png

description: 
  text: Powered by custom HTML tags that work in any system, HAX is a lightweight, easy to use flat file CMS with a powerful design pattern focused on authoring experience in order to build sustainable and engaging content.
  
categories:
- apps/content-management
- apps/education

globals:
  # fn.password is letters/digits only; the fixed prefix/suffix guarantee the
  # installer's policy (upper, lower, number and symbol)
  HAX_ADMIN_PASS: Hx-${fn.password(14)}-7
  HAX_INSTALL_TOKEN: ${fn.password(32)}

nodes:
  nodeType: apache2
  nodeGroup: cp
  cloudlets: 8
  extip: false
  displayName: Application Server

onInstall:
  - configSystem
  - deployApp
  - writeInstallToken
  - setupUser

actions:
  deployApp:
    cmd[cp]: |-
      # Find version number of latest release
      function get_latest_release {
        curl --silent "https://api.github.com/repos/haxtheweb/haxcms-php/releases/latest" |
        grep '"tag_name":' |
        sed -E 's/.*"([^"]+)".*/\1/' |
        sed 's/^v//'
      }
      LATEST=`get_latest_release`
      # Download and unzip archive
      cd /var/www/webroot/ROOT
      wget https://github.com/haxtheweb/haxcms-php/archive/refs/tags/$LATEST.zip
      unzip $LATEST.zip
      cd haxcms-php-$LATEST/
      mv * .[^.]* ..
      cd ..
      rm $LATEST.zip
      rm -r haxcms-php-$LATEST/

  configSystem:
    cmd[cp]: |-
      sed -i 's|;extension=gd.so|extension=gd.so|g' /etc/php.ini;
      sudo /etc/init.d/httpd restart;
    user: root
    
  writeInstallToken:
    cmd[cp]: |-
      echo -n "${globals.HAX_INSTALL_TOKEN}" > /var/www/webroot/ROOT/_installtoken.txt;
      chmod 600 /var/www/webroot/ROOT/_installtoken.txt;
    
  setupUser:
    cmd[cp]: |-
      # Direct install: op=advance + toStep=4 is the only request that applies
      # POSTed credentials. grep fails the deploy if the install did not finish.
      curl -fsS -X POST "http://${env.domain}/install.php?op=advance" \
        --data-urlencode "toStep=4" \
        --data-urlencode "user=admin" \
        --data-urlencode "pass=${globals.HAX_ADMIN_PASS}" \
        --data-urlencode "install_token=${globals.HAX_INSTALL_TOKEN}" | grep -q '"step":4'
     
ssl: true
skipNodeEmails: true
  
success: | 
  **Site URL**: [https://${env.domain}/](https://${env.domain}/)
  
  **Username**: admin
  
  **Password**: ${globals.HAX_ADMIN_PASS}
